# Inputs for `mise run cf:access-setup` (shared task at
# .github/mise-tasks/cf/access-setup). The script reads this file, ensures a
# Cloudflare Access App + allow-by-email policy exist for the Worker's
# workers.dev URL, and writes CF_ACCESS_TEAM_DOMAIN + the per-app policy AUD
# back to the fnox keychain.
#
# Adding more allowed users later: append to OPERATOR_EMAIL (comma-separated)
# and re-run the task — it's idempotent and adds new emails to the existing
# allow policy without disrupting current sessions.
#
# Format: KEY=value (no spaces around `=`, parser uses regex ^[A-Z_][A-Z0-9_]*=).

WORKER_NAME=quick-worker
CF_SUBDOMAIN=gedw99
APP_POLICY_AUD_FNOX_KEY=QUICK_WORKER_POLICY_AUD
OPERATOR_EMAIL=gedw99@gmail.com,3dblume@gmail.com,trinoxf@gmail.com
