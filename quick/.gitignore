# Rust build output (workspace target dir at quick/)
target/

# Generated by mise run fonts — re-run to restore
resources/fonts/

# Generated PDFs — re-run to restore
out/

# Intermediate typst compile file
_tmp.typ

# Theme test output PDFs (generated by `quick-tool themes test`)
_theme_test_*.pdf

# Thai translations are committed alongside EN source so CI can build
# PDFs without needing the claude CLI or ANTHROPIC_API_KEY.
# Run `mise run translate` locally to regenerate after editing EN files.

# Cloudflare Worker local dev secrets (never commit)
cf/.dev.vars

# Worker build output
cf/build/
cf/dist/

# Wrangler local state and cache (per-machine, never commit)
.wrangler/
cf/.wrangler/

# Node — per-machine package installs
cf/node_modules/
local/node_modules/

# Claude Code per-machine settings
.claude/

# Local research / cloned reference repos (never commit)
.src/

.dev.vars*
!.dev.vars.example
.env*
!.env.example
