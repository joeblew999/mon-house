# Production environment config — read by the shared joeblew999 mise-tasks.
#
# Used by:
#   cf:access-setup        — provisions the CF Access App + GitHub-IdP allow
#                            policy in front of the Worker, writes TEAM_DOMAIN
#                            and per-app POLICY_AUD into fnox (keychain).
#   cf:secrets-put-mapped  — pushes 4 mapped fnox secrets to the Worker:
#                              ACCOUNT_ID, API_KEY, TEAM_DOMAIN, POLICY_AUD.
#
# Re-run cf:access-setup whenever OPERATOR_EMAIL changes — the script
# auto-revokes any sessions for emails removed from the allow list (so
# yanking access takes effect within seconds, not 24h).
#
# All values are public — fnox holds the actual secrets. Don't put secrets here.

# Worker identity. CF_SUBDOMAIN is the bit in front of `.workers.dev` for
# this account (visible in the dashboard under Workers & Pages).
WORKER_NAME="quick-worker"
CF_SUBDOMAIN="gedw99"

# Comma-separated emails that the Access GitHub-IdP policy allows. The
# allowlist auto-syncs on cf:access-setup runs (adds + removes; sessions
# for removed addresses are revoked). Keep alphabetical for diff sanity.
OPERATOR_EMAIL="gedw99@gmail.com"

# Canonical fnox key under which this app's Access AUD is stored. The
# AUD is opaque — pick any unique name; matters only for cross-tool
# referencing (cf:secrets-put-mapped reads from this key, the Worker
# verifies request JWTs against the AUD value at runtime).
APP_POLICY_AUD_FNOX_KEY="QUICK_WORKER_POLICY_AUD"

# ── Local-dev / automation auth ───────────────────────────────────────────────
#
# The shared tasks above only handle production. For local dev (`mise run dev`
# proxying remote=true bindings through vite-plugin) and Playwright-against-
# prod automation, wrangler/Playwright also need an Access SERVICE token to
# get past the auth wall non-interactively.
#
# One-time setup (per machine that will run dev or automation):
#
#   1. https://one.dash.cloudflare.com/ → Access → Service Auth → Service Tokens
#      → Create Service Token (any name, e.g. "quick-local-dev")
#   2. Add the token's CLIENT_ID as an "Include" rule on the Access App's
#      operator-only policy (so the token is allowed through).
#   3. Store both creds in fnox:
#        fnox set --global -p keychain CLOUDFLARE_ACCESS_CLIENT_ID
#        fnox set --global -p keychain CLOUDFLARE_ACCESS_CLIENT_SECRET
#
# After that, `mise run dev` and `mise run 10-deploy` work non-interactively
# because the dev/deploy tasks wrap in `fnox exec --` which injects these
# alongside CLOUDFLARE_API_TOKEN.
