# Dockerfile.compiler — Typst PDF compiler container for the CF pipeline.
#
# Build context = cf/ (after `mise run cf:prepare` copies source files in).
# Prepared layout expected in cf/:
#   cli/         — quick-tool Rust source
#   Cargo.toml   — workspace root (members = ["cli"])
#   Cargo.lock
#   scripts/     — Typst theme .typ files
#   resources/fonts/  — pre-downloaded .ttf files
#
# Runtime: POST /compile {name, content} → PDF bytes (port 8080)
#          GET  /health                  → 200 "ok"

# ── Stage 1: build quick-tool ────────────────────────────────────────────────
FROM rust:slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY cli/ cli/

# container feature: tiny_http (serve) + which — no file watching, no WS client
RUN cargo build --release \
        --no-default-features --features container \
        --manifest-path cli/Cargo.toml

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils && \
    rm -rf /var/lib/apt/lists/*

# Install typst (statically linked musl binary — works on any glibc system)
RUN ARCH="x86_64" && \
    curl -fsSL \
      "https://github.com/typst/typst/releases/latest/download/typst-${ARCH}-unknown-linux-musl.tar.xz" \
      -o /tmp/typst.tar.xz && \
    tar -xJf /tmp/typst.tar.xz -C /tmp && \
    mv /tmp/typst-${ARCH}-unknown-linux-musl/typst /usr/local/bin/typst && \
    rm -rf /tmp/typst.tar.xz "/tmp/typst-${ARCH}-unknown-linux-musl"

# Copy quick-tool binary
COPY --from=builder /build/cli/target/release/quick-tool /usr/local/bin/quick-tool

# Copy Typst theme scripts and pre-baked fonts
COPY scripts/     /app/scripts/
COPY resources/fonts/ /app/resources/fonts/

WORKDIR /app

# Config via env vars — same names as the local CLI (clap env = "QUICK_*")
ENV QUICK_SCRIPTS_DIR=/app/scripts \
    QUICK_FONT_DIR=/app/resources/fonts \
    QUICK_RESOURCES_DIR=/app/resources \
    QUICK_SPECS_DIR=/tmp/specs \
    QUICK_OUT_DIR=/tmp/out

EXPOSE 8080
CMD ["quick-tool", "serve", "--port", "8080"]
